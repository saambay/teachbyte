generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parent {
  id                    String   @id @default(uuid()) @db.Uuid
  email                 String   @unique
  name                  String
  notifications_enabled Boolean  @default(true)
  daily_session_reminder Boolean @default(false)
  reminder_time         String?  // HH:MM format
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  students Student[]

  @@map("parents")
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  parent_id   String   @db.Uuid
  name        String
  age         Int
  grade_level Int
  avatar_url  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent            Parent             @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  sessions          Session[]
  progress          StudentProgress[]
  streak            StreakData?
  difficultyProfile DifficultyProfile?

  @@map("students")
}

model Topic {
  id                    String @id @default(uuid()) @db.Uuid
  title                 String
  domain                String // science, math, reading, general
  description           String
  key_concepts          String[] // PostgreSQL array
  common_misconceptions String[] // PostgreSQL array
  difficulty_level      Int // 1-3
  age_range_min         Int
  age_range_max         Int
  micro_lesson_explainer_points    String[] @default([])
  micro_lesson_fun_facts           String[] @default([])
  micro_lesson_visual_descriptions String[] @default([])
  created_at                       DateTime @default(now())

  sessions             Session[]
  progress             StudentProgress[]
  challenges           ChallengeScenario[]
  outgoingRelationships TopicRelationship[] @relation("TopicFrom")
  incomingRelationships TopicRelationship[] @relation("TopicTo")

  @@map("topics")
}

model ChallengeScenario {
  id               String   @id @default(uuid()) @db.Uuid
  topic_id         String   @db.Uuid
  title            String
  scenario         String
  question         String
  hints            String[] @default([])
  difficulty_level Int      // 1-3
  age_range_min    Int
  age_range_max    Int
  created_at       DateTime @default(now())

  topic Topic @relation(fields: [topic_id], references: [id])

  @@map("challenge_scenarios")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  student_id      String   @db.Uuid
  topic_id        String?  @db.Uuid
  status          String   @default("idle") // idle, starting, coach_greeting, topic_selection, teaching, coach_summary, completed, abandoned
  started_at      DateTime @default(now())
  ended_at        DateTime?
  duration_seconds Int     @default(0)
  teaching_score_clarity      Int?
  teaching_score_completeness Int?
  teaching_score_engagement   Int?
  teaching_score_overall      Float?
  summary         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  student  Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  topic    Topic?    @relation(fields: [topic_id], references: [id])
  messages SessionMessage[]

  @@map("sessions")
}

model SessionMessage {
  id          String   @id @default(uuid()) @db.Uuid
  session_id  String   @db.Uuid
  role        String   // student, agent
  content     String
  agent_type  String?  // coach, teaching_buddy, etc.
  created_at  DateTime @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("session_messages")
}

model StudentProgress {
  id                 String   @id @default(uuid()) @db.Uuid
  student_id         String   @db.Uuid
  topic_id           String   @db.Uuid
  status             String   @default("not_started") // not_started, in_progress, mastered
  sessions_completed Int      @default(0)
  best_clarity       Int?
  best_completeness  Int?
  best_engagement    Int?
  best_overall       Float?
  last_attempted_at  DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topic_id], references: [id])

  @@unique([student_id, topic_id])
  @@map("student_progress")
}

model TopicRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  topic_id         String   @db.Uuid
  related_topic_id String   @db.Uuid
  relationship_type String  // prerequisite, related, builds_on
  created_at       DateTime @default(now())

  topic        Topic @relation("TopicFrom", fields: [topic_id], references: [id])
  relatedTopic Topic @relation("TopicTo", fields: [related_topic_id], references: [id])

  @@unique([topic_id, related_topic_id])
  @@map("topic_relationships")
}

model StreakData {
  id                String   @id @default(uuid()) @db.Uuid
  student_id        String   @unique @db.Uuid
  current_streak    Int      @default(0)
  longest_streak    Int      @default(0)
  last_session_date DateTime?
  streak_status     String   @default("broken") // active, paused, broken
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("streak_data")
}

model DifficultyProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  student_id             String   @unique @db.Uuid
  current_level          Float    @default(1.0)
  success_rate           Float    @default(0.0)
  consecutive_successes  Int      @default(0)
  consecutive_failures   Int      @default(0)
  total_challenges       Int      @default(0)
  total_correct          Int      @default(0)
  last_calibration_at    DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("difficulty_profiles")
}
